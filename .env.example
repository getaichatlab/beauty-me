# Runtime server variables. Never prefix privileged keys with PUBLIC_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_SITE_ID=11111111-1111-4111-8111-111111111111
# Used only by the first-time seed importer. No password is needed here.
ADMIN_OWNER_EMAIL=
# Set at build time when enabling database-driven public pages on Netlify.
PUBLIC_CONTENT_MODE=dynamic
# Optional, only after the salon notification destination is confirmed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
